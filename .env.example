# Copy this file to .env.local for local development (never commit .env.local)

# OpenAI API key — set this in Vercel's dashboard under Environment Variables
VITE_OPENAI_API_KEY=sk-proj-...

# Default AI provider on first load: 'openai' or 'ollama'
# Users can switch at runtime via the toggle in the header
VITE_DEFAULT_AI_PROVIDER=openai
